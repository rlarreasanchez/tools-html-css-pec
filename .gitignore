# Directorio de salida de Parcel (por defecto es 'dist')
dist/

# Caché de Parcel (donde guarda datos temporales para compilaciones rápidas)
.parcel-cache/

# Dependencias de Node.js
node_modules/

# Archivos de sistema y logs
npm-debug.log*

# Archivos generados de las recetas
src/pages/det*.html

# Archivos generados de iconos SVG
src/images/icons/icons-sprite.svg
src/partials/icon-sprite.html